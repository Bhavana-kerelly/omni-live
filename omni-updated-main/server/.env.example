# OMNI Hospitals Backend Environment Configuration

PORT=5000
CORS_ORIGIN=http://localhost:5173

# LeadSquared API Configuration
LEADSQUARED_BASE_URL=https://api-in21.leadsquared.com/v2/
LEADSQUARED_ENDPOINT_ACTION=LeadManagement.svc/Lead.Capture
LEADSQUARED_ACCESS_KEY=YOUR_ACCESS_KEY
LEADSQUARED_SECRET_KEY=YOUR_SECRET_KEY

# ConVox Click-to-Call API Configuration
# API URL format from ConVoxCCS 4.0.3 docs: https://<server-ip>/ConVoxCCS/rest/api
CONVOX_API_URL=https://YOUR_CONVOX_SERVER_IP/ConVoxCCS/rest/api
CONVOX_ACCESS_TOKEN=YOUR_CONVOX_ACCESS_TOKEN
CONVOX_USERID=YOUR_CONVOX_USERID
# Dial prefix if required by your ConVox setup (leave blank if not needed)
CONVOX_DIAL_PREFIX=
